<Controls:MetroWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    Title="Update Planner"
    Width="1320" Height="820"
    MinWidth="1024" MinHeight="640"
    WindowStartupLocation="CenterScreen"
    TitleCharacterCasing="Normal"
    GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
    NonActiveGlowBrush="{DynamicResource MahApps.Brushes.Accent}"
    BorderThickness="1"
    ShowIconOnTitleBar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Dark.Steel.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ControlTemplate x:Key="SidebarButtonTemplate" TargetType="Button">
                <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      SnapsToDevicePixels="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Bd" Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="#3A3A3A"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <!-- A disabled sidebar button keeps its text colour (opacity would drop the contrast below 4.5:1) and shows normal weight text. -->
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="FontWeight" Value="Normal"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- Contrast overrides of the MahApps theme brushes. One value passes in both themes:
                 #7F7F7F is 4.0:1 on white and 3.8:1 on #252525 (control borders need 3:1);
                 white title text is 7.0:1 on #595959 (the inactive title bar). -->
            <SolidColorBrush x:Key="MahApps.Brushes.TextBox.Border" Color="#7F7F7F"/>
            <SolidColorBrush x:Key="MahApps.Brushes.WindowTitle.NonActive" Color="#595959"/>

            <!-- Square button without the MahApps disabled state, which fades the text below 4.5:1.
                 A disabled button shows MahApps.Brushes.Gray.MouseOver text (#AAAAAA dark, #333333 light)
                 and a #7F7F7F border. -->
            <ControlTemplate x:Key="AppSquareButtonTemplate" TargetType="ButtonBase">
                <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      SnapsToDevicePixels="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MahApps.Brushes.Button.Square.Background.MouseOver}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Button.Square.Foreground.MouseOver}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="AppSquareButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Square}">
                <Setter Property="Template" Value="{StaticResource AppSquareButtonTemplate}"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Check box and radio button text keeps 4.5:1 when disabled. -->
            <Style TargetType="CheckBox" BasedOn="{StaticResource MahApps.Styles.CheckBox}">
                <Setter Property="Controls:CheckBoxHelper.ForegroundUncheckedDisabled" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                <Setter Property="Controls:CheckBoxHelper.ForegroundCheckedDisabled" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                <Setter Property="Controls:CheckBoxHelper.ForegroundIndeterminateDisabled" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
            </Style>
            <Style TargetType="RadioButton" BasedOn="{StaticResource MahApps.Styles.RadioButton}">
                <Setter Property="Controls:RadioButtonHelper.ForegroundDisabled" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
            </Style>

            <!-- Tab header text in the theme foreground: the MahApps grey of an unselected tab is below 4.5:1. -->
            <Style x:Key="TabHeaderText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ViewButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Square}">
                <Setter Property="Template" Value="{StaticResource SidebarButtonTemplate}"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="Margin" Value="8,3,8,3"/>
                <Setter Property="Padding" Value="12,0,12,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Controls:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background">
                    <Setter.Value><SolidColorBrush Color="#1E1E1E"/></Setter.Value>
                </Setter>
                <Setter Property="BorderBrush">
                    <Setter.Value><SolidColorBrush Color="#555555"/></Setter.Value>
                </Setter>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="OptionsButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewButtonStyle}"/>

            <Style x:Key="SquareInlineButtonStyle" TargetType="Button" BasedOn="{StaticResource AppSquareButtonStyle}">
                <Setter Property="Height" Value="28"/>
                <Setter Property="MinWidth" Value="100"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Controls:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="ViewDataGridRow" TargetType="DataGridRow"
                   BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ViewDataGrid" TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Extended"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ColumnHeaderHeight" Value="30"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource MahApps.Brushes.Gray8}"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="RowStyle" Value="{StaticResource ViewDataGridRow}"/>
            </Style>

            <Style x:Key="GridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
                <Setter Property="Padding" Value="6,0,6,0"/>
            </Style>

            <Style x:Key="TrimmedTextStyle" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            </Style>

            <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader}">
                <Setter Property="Padding" Value="6,0,6,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <Style x:Key="DetailTextStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8"/>
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray1}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,14,14,12">
                    <TextBlock x:Name="txtAppTitle" Text="Update Planner"
                               FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="txtVersion" Text="" FontSize="10"
                               Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,14">
                    <Separator Margin="0,8,0,10"/>
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="txtThemeLabel" Text="Dark Theme"
                                   DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"/>
                        <Controls:ToggleSwitch x:Name="toggleTheme"
                                               DockPanel.Dock="Right"
                                               IsOn="True"
                                               OnContent="" OffContent=""
                                               MinWidth="0"
                                               ToolTip="Toggle dark / light theme"/>
                    </DockPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button x:Name="btnViewPlan"   Content="Plan"   Style="{StaticResource ViewButtonStyle}"
                                ToolTip="Choose the wave collections and dates, then build the plan"/>
                        <Button x:Name="btnViewReport" Content="Report" Style="{StaticResource ViewButtonStyle}"
                                ToolTip="The plan as a Markdown or HTML report"/>
                        <Button x:Name="btnViewApply"  Content="Deploy" Style="{StaticResource ViewButtonStyle}"
                                ToolTip="Dry run and create the deployments of the plan"/>

                        <Button x:Name="btnOptions" Content="Options"
                                Style="{StaticResource OptionsButtonStyle}"
                                Margin="8,24,8,3"
                                ToolTip="Site code, SMS provider, about"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource MahApps.Brushes.Gray8}"/>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="140"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource MahApps.Brushes.Gray10}" Padding="16,12,16,10">
                <StackPanel>
                    <TextBlock x:Name="txtModuleTitle" Text="Plan" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtModuleSubtitle"
                               Text="Add the wave collections in the order of the rollout, set the dates, then click Build plan. Building a plan changes nothing on the site."
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Padding="16,10,16,10">
                <DockPanel LastChildFill="False">
                    <Button x:Name="btnBuildPlan" DockPanel.Dock="Left" Content="Build plan"
                            Style="{StaticResource SquareInlineButtonStyle}" MinWidth="120"
                            ToolTip="Read the site and build the plan. Nothing changes on the site."/>
                    <Button x:Name="btnLoadCollections" DockPanel.Dock="Left" Content="Load collections"
                            Style="{StaticResource SquareInlineButtonStyle}" MinWidth="140"
                            ToolTip="Read the device collections and console folders from the site"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="btnExportJson" Content="Export JSON"
                                Style="{StaticResource SquareInlineButtonStyle}"
                                ToolTip="Save the plan as a JSON file"/>
                        <Button x:Name="btnExportMarkdown" Content="Export Markdown"
                                Style="{StaticResource SquareInlineButtonStyle}" MinWidth="130"
                                ToolTip="Save the plan as a Markdown review file"/>
                        <Button x:Name="btnExportHtml" Content="Export HTML"
                                Style="{StaticResource SquareInlineButtonStyle}" Margin="0"
                                ToolTip="Save the plan as an HTML report"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2" Margin="8,0,8,0">

                <!-- ============================================================ -->
                <!-- View: Plan                                                   -->
                <!-- ============================================================ -->
                <Grid x:Name="viewPlan" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="8,0,8,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Wave collections, in order" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="lstWaves" Grid.Column="0" Height="116" FontSize="12"
                                         Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                                         BorderThickness="1"
                                         BorderBrush="{DynamicResource MahApps.Brushes.TextBox.Border}"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <Button x:Name="btnAddWave"    Content="Add..."  Style="{StaticResource SquareInlineButtonStyle}" MinWidth="90" Margin="0,0,0,4"
                                            ToolTip="Pick a device collection. The list is searchable."/>
                                    <Button x:Name="btnRemoveWave" Content="Remove"  Style="{StaticResource SquareInlineButtonStyle}" MinWidth="90" Margin="0,0,0,4"/>
                                    <Button x:Name="btnWaveUp"     Content="Move up" Style="{StaticResource SquareInlineButtonStyle}" MinWidth="90" Margin="0,0,0,4"/>
                                    <Button x:Name="btnWaveDown"   Content="Move down" Style="{StaticResource SquareInlineButtonStyle}" MinWidth="90" Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="Wave 1 start date" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker x:Name="dpStartDate" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,10">
                                <TextBlock Text="Days between waves" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtSpacing" FontSize="12" Padding="6,4,6,4" Text="7"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                <TextBlock Text="Days to deadline" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtDeadline" FontSize="12" Padding="6,4,6,4" Text="3"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="Lowest severity" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="cboSeverity" FontSize="12">
                                    <ComboBoxItem Content="All" IsSelected="True"/>
                                    <ComboBoxItem Content="Low"/>
                                    <ComboBoxItem Content="Moderate"/>
                                    <ComboBoxItem Content="Important"/>
                                    <ComboBoxItem Content="Critical"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,10">
                                <TextBlock Text="Most updates per wave" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtMaxUpdates" FontSize="12" Padding="6,4,6,4" Text="1000"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10" VerticalAlignment="Bottom">
                                <CheckBox x:Name="chkWsus" Content="Include WSUS counts" FontSize="12"
                                          ToolTip="Also read update counts from the WSUS server on the provider computer"/>
                            </StackPanel>

                            <TextBlock x:Name="txtPlanSummary" Grid.Row="2" Grid.ColumnSpan="3" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                                       Text="No plan yet."/>
                        </Grid>
                    </Grid>

                    <TabControl Grid.Row="1" Controls:TabControlHelper.Underlined="TabPanel">
                        <TabItem x:Name="tabPlanned" Controls:HeaderedControlHelper.HeaderFontSize="13">
                            <TabItem.Header><TextBlock x:Name="txtTabPlanned" Text="Planned updates" Style="{StaticResource TabHeaderText}"/></TabItem.Header>
                            <DataGrid x:Name="gridPlan"
                                      Style="{StaticResource ViewDataGrid}"
                                      ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                      CellStyle="{StaticResource GridCellStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Wave"      Width="56"  Binding="{Binding Wave}"/>
                                    <DataGridTextColumn Header="Collection" Width="2*" Binding="{Binding Collection}"/>
                                    <DataGridTextColumn Header="Start"     Width="96"  Binding="{Binding Start}"/>
                                    <DataGridTextColumn Header="Deadline"  Width="96"  Binding="{Binding Deadline}"/>
                                    <DataGridTextColumn Header="#"         Width="40"  Binding="{Binding Sequence}"/>
                                    <DataGridTextColumn Header="Article"   Width="90"  Binding="{Binding Article}"/>
                                    <DataGridTextColumn Header="Severity"  Width="90"  Binding="{Binding Severity}"/>
                                    <DataGridTextColumn Header="Devices"   Width="72"  Binding="{Binding Devices}"/>
                                    <DataGridTextColumn Header="Title"     Width="4*"  Binding="{Binding Title}" ElementStyle="{StaticResource TrimmedTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem x:Name="tabSkipped" Controls:HeaderedControlHelper.HeaderFontSize="13">
                            <TabItem.Header><TextBlock x:Name="txtTabSkipped" Text="Skipped updates" Style="{StaticResource TabHeaderText}"/></TabItem.Header>
                            <DataGrid x:Name="gridSkipped"
                                      Style="{StaticResource ViewDataGrid}"
                                      ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                      CellStyle="{StaticResource GridCellStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Reason"  Width="140" Binding="{Binding Reason}"/>
                                    <DataGridTextColumn Header="Wave"    Width="2*"  Binding="{Binding Wave}"/>
                                    <DataGridTextColumn Header="Article" Width="90"  Binding="{Binding Article}"/>
                                    <DataGridTextColumn Header="Title"   Width="4*"  Binding="{Binding Title}" ElementStyle="{StaticResource TrimmedTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- ============================================================ -->
                <!-- View: Report                                                 -->
                <!-- ============================================================ -->
                <Grid x:Name="viewReport" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,0,8,8">
                        <RadioButton x:Name="rdoMarkdown" Content="Markdown" IsChecked="True" GroupName="ReportFormat" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="rdoHtml"     Content="HTML source" GroupName="ReportFormat" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <Button x:Name="btnOpenHtml" Content="Open HTML report" Style="{StaticResource SquareInlineButtonStyle}" MinWidth="150" Margin="8,0,8,0"
                                ToolTip="Write the HTML report to the Reports folder and open it in the default browser"/>
                        <Button x:Name="btnCopyReport" Content="Copy" Style="{StaticResource SquareInlineButtonStyle}"
                                ToolTip="Copy the text to the clipboard"/>
                    </StackPanel>
                    <TextBox x:Name="txtReport" Grid.Row="1" Style="{StaticResource DetailTextStyle}"
                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                             Text="Build a plan to see the report."/>
                </Grid>

                <!-- ============================================================ -->
                <!-- View: Deploy                                                 -->
                <!-- ============================================================ -->
                <Grid x:Name="viewApply" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="170"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="8,0,8,10">
                        <StackPanel>
                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                       Text="Update Planner only reads the site until you turn on Enable actions. Dry run shows what Deploy would create and changes nothing. Deploy creates one software update group and one deployment of that group for each wave that holds updates, after you confirm."/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Controls:ToggleSwitch x:Name="toggleActions" IsOn="False"
                                                       Header="Enable actions"
                                                       OnContent="On" OffContent="Off" MinWidth="0" Margin="0,0,24,0"
                                                       ToolTip="Dry run and Deploy stay disabled until this switch is on"/>
                                <Button x:Name="btnDryRun" Content="Dry run" Style="{StaticResource SquareInlineButtonStyle}" MinWidth="120" VerticalAlignment="Bottom"
                                        ToolTip="Run the deploy step with -WhatIf. Nothing is created."/>
                                <Button x:Name="btnApply" Content="Deploy..." Style="{StaticResource SquareInlineButtonStyle}" MinWidth="120" VerticalAlignment="Bottom"
                                        ToolTip="Create the deployments after a confirmation"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="gridPreview" Grid.Row="1"
                              Style="{StaticResource ViewDataGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Deployment name" Width="3*" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Collection"      Width="2*" Binding="{Binding Collection}"/>
                            <DataGridTextColumn Header="ID"              Width="90" Binding="{Binding CollectionId}"/>
                            <DataGridTextColumn Header="Updates"         Width="70" Binding="{Binding UpdateCount}"/>
                            <DataGridTextColumn Header="Start"           Width="96" Binding="{Binding Start}"/>
                            <DataGridTextColumn Header="Deadline"        Width="96" Binding="{Binding Deadline}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource MahApps.Brushes.Gray8}"
                                  ResizeDirection="Rows"/>

                    <DataGrid x:Name="gridResults" Grid.Row="3"
                              Style="{StaticResource ViewDataGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Result"      Width="90"  Binding="{Binding Status}"/>
                            <DataGridTextColumn Header="Wave"        Width="2*"  Binding="{Binding Wave}"/>
                            <DataGridTextColumn Header="Collection"  Width="100" Binding="{Binding CollectionId}"/>
                            <DataGridTextColumn Header="Updates"     Width="70"  Binding="{Binding UpdateCount}"/>
                            <DataGridTextColumn Header="Assignment"  Width="100" Binding="{Binding AssignmentId}"/>
                            <DataGridTextColumn Header="Message"     Width="3*"  Binding="{Binding Message}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Border x:Name="progressOverlay"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                        Opacity="0.92">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Controls:ProgressRing IsActive="True" Width="56" Height="56"
                                               Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                        <TextBlock x:Name="txtProgressTitle"
                                   Text="Loading..."
                                   FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0"/>
                        <TextBlock x:Name="txtProgressStep"
                                   Text=""
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray1}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource MahApps.Brushes.Gray8}"
                          ResizeDirection="Rows"/>

            <Border Grid.Row="4">
                <DockPanel>
                    <TextBlock x:Name="lblLogOutput" DockPanel.Dock="Top" Text="LOG OUTPUT"
                               FontSize="10" FontWeight="SemiBold"
                               Margin="8,6,0,4"/>
                    <TextBox x:Name="txtLog"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="11"
                             BorderThickness="0"
                             Margin="4,0,4,4"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="5" Padding="8,4,8,4"
                    Background="{DynamicResource MahApps.Brushes.Gray10}">
                <TextBlock x:Name="txtStatus" Text="Ready." FontSize="11"/>
            </Border>
        </Grid>
    </Grid>

</Controls:MetroWindow>
